From: Linux3 Build Project <linux3@example.com>
Date: Thu, 11 Jun 2026 12:00:00 +0800
Subject: [PATCH 1/3] compiler-gcc: Add GCC 14 compatibility fixes

Fixes the __noclone macro to not use 'no-tracer' optimize attribute
which was removed in GCC 4.7 and causes errors with GCC 14+.
Also adds KASAN ABI version for GCC >= 14 and provides a fallback
for __designated_init attribute which was removed in GCC 14.

Signed-off-by: Linux3 Build Project <linux3@example.com>

diff --git a/include/linux/compiler-gcc.h b/include/linux/compiler-gcc.h
index ff8f2ea39b88..ec97a2de0e0a 100644
--- a/include/linux/compiler-gcc.h
+++ b/include/linux/compiler-gcc.h
@@ -177,7 +177,11 @@
 #define unreachable() __builtin_unreachable()
 
 /* Mark a function definition as prohibited from being cloned. */
+#if GCC_VERSION < 40700
 #define __noclone	__attribute__((__noclone__, __optimize__("no-tracer")))
+#else
+#define __noclone	__attribute__((__noclone__))
+#endif /* GCC_VERSION < 40700 */
 
 #endif /* GCC_VERSION >= 40500 */
 
@@ -213,10 +217,13 @@
- #if GCC_VERSION >= 50000
- #define KASAN_ABI_VERSION 4
- #elif GCC_VERSION >= 40902
- #define KASAN_ABI_VERSION 3
- #endif
+ #if GCC_VERSION >= 140000
+ #define KASAN_ABI_VERSION 5
+ #elif GCC_VERSION >= 50000
+ #define KASAN_ABI_VERSION 4
+ #elif GCC_VERSION >= 40902
+ #define KASAN_ABI_VERSION 3
+ #endif
+
+#if !defined(__designated_init)
+#define __designated_init
+#endif
 
  #endif	/* gcc version >= 40000 specific checks */
 
 #if !defined(__noclone)
